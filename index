        const modalVideo = document.getElementById('modal-video');
        const modalTitle = document.getElementById('modal-title');
        const modalType = document.getElementById('modal-type');
        const modalYear = document.getElementById('modal-year');
        const modalDesc = document.getElementById('modal-desc');
        const closeModalBtn = document.getElementById('close-modal');

        function openModal(data) {
            modalTitle.textContent = data.title;
            modalType.textContent = data.type[currentLang];
            if(modalYear) modalYear.textContent = data.year;
            modalDesc.textContent = data.description[currentLang];
            modalVideo.src = data.video;
            
            modal.classList.remove('hidden');
            setTimeout(() => modal.classList.remove('opacity-0'), 10);
            
            modalVideo.play();
            document.body.style.overflow = 'hidden';
        }

        function closeModal() {
            modal.classList.add('opacity-0');
            setTimeout(() => {
                modal.classList.add('hidden');
                modalVideo.pause();
                modalVideo.src = "";
                document.body.style.overflow = ''; 
            }, 500);
        }

        closeModalBtn.addEventListener('click', closeModal);

        // Mobile Menu
        const menuBtn = document.getElementById('menu-btn');
        const closeMenuBtn = document.getElementById('close-menu');
        const mobileMenu = document.getElementById('mobile-menu');
        
        menuBtn.addEventListener('click', () => mobileMenu.classList.remove('opacity-0', 'pointer-events-none'));
        const closeMobile = () => mobileMenu.classList.add('opacity-0', 'pointer-events-none');
        closeMenuBtn.addEventListener('click', closeMobile);
        document.querySelectorAll('.mobile-link').forEach(l => l.addEventListener('click', closeMobile));

        window.addEventListener('load', () => {
            renderGrid();
            setLanguage('fr');
            addCursorHover();
            setTimeout(() => {
                document.getElementById('loader').style.transform = 'translateY(-100%)';
            }, 1200);
        });

    </script>
</body>
</html>
